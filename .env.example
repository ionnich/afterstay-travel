# AfterStay Travel — client environment.
# Copy to `.env` and fill in values. All vars are public (EXPO_PUBLIC_*) and
# baked into the app bundle at build time — nothing here is a secret.

# ── Required ────────────────────────────────────────────────────────────────
# REST API base URL (AWS API Gateway stage root)
EXPO_PUBLIC_API_URL=

# AWS Cognito user pool id + app client id
EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_CLIENT_ID=

# ── Optional ────────────────────────────────────────────────────────────────
# WebSocket chat URL (leave empty to disable realtime chat)
EXPO_PUBLIC_WS_URL=

# Cognito hosted-UI domain (needed for Google OAuth sign-in)
EXPO_PUBLIC_COGNITO_OAUTH_DOMAIN=

# Google OAuth web client id (needed for Google OAuth sign-in)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Native Google Maps SDK key (Android tiles; also read by app.config.js)
EXPO_PUBLIC_GOOGLE_MAPS_SDK_KEY=

# Unused — Sentry was removed; kept only for backward-compat in verifyConfig().
EXPO_PUBLIC_SENTRY_DSN=
